<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <!-- 1. Background gỗ toàn màn hình đồng bộ với Home/Activity -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        android:contentDescription="@null" />

    <!-- 2. Header Section (Tiêu đề căn giữa cho Fragment) -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="50dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Tài khoản"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <!-- 3. Tấm nền giấy da bo tròn (Đồng bộ với Home) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar"
                    app:shapeAppearanceOverlay="@style/Circle"
                    app:strokeColor="#6D4C41"
                    app:strokeWidth="2.5dp" />

                <TextView
                    android:id="@+id/tv_display_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="serif"
                    android:text="Tên người dùng"
                    android:textColor="#4E342E"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_display_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="serif"
                    android:text="email@example.com"
                    android:textColor="#6D4C41"
                    android:textSize="15sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Card Thông tin chi tiết -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="serif"
                android:text="Chi tiết tài khoản"
                android:textColor="#4E342E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FDF5E6"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Họ và tên" android:textColor="#8D6E63" android:fontFamily="serif" />
                        <TextView android:id="@+id/tv_info_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#4E342E" android:textStyle="bold" android:fontFamily="serif" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#E0D4C3" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Email" android:textColor="#8D6E63" android:fontFamily="serif" />
                        <TextView android:id="@+id/tv_info_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#4E342E" android:fontFamily="serif" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#E0D4C3" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Số điện thoại" android:textColor="#8D6E63" android:fontFamily="serif" />
                        <TextView android:id="@+id/tv_info_phone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#4E342E" android:fontFamily="serif" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#E0D4C3" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Vai trò" android:textColor="#8D6E63" android:fontFamily="serif" />
                        <TextView android:id="@+id/tv_info_role" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Người dùng" android:textColor="#2E7D32" android:textStyle="bold" android:fontFamily="serif" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#E0D4C3" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Ngày tham gia" android:textColor="#8D6E63" android:fontFamily="serif" />
                        <TextView android:id="@+id/tv_info_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#4E342E" android:fontFamily="serif" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tùy chọn chức năng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="serif"
                android:text="Tùy chọn"
                android:textColor="#4E342E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FDF5E6"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_edit_profile"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_edit" app:tint="#6D4C41" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:fontFamily="serif" android:text="Chỉnh sửa hồ sơ" android:textColor="#4E342E" android:textStyle="bold" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_arrow_right_1" app:tint="#8D6E63" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="20dp" android:background="#E0D4C3" />

                    <LinearLayout
                        android:id="@+id/btn_change_password"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_lock_idle_lock" app:tint="#6D4C41" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:fontFamily="serif" android:text="Đổi mật khẩu" android:textColor="#4E342E" android:textStyle="bold" />
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_arrow_right_1" app:tint="#8D6E63" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFEBE9" />

                    <LinearLayout
                        android:id="@+id/btn_add_monan"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_add"
                            app:tint="#5D4037" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:text="Thêm món ăn"
                            android:textColor="#3E2723"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_admin_1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFEBE9"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/btn_admin_users"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#5D4037" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:text="Quản lý người dùng"
                            android:textColor="#3E2723"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_admin_2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFEBE9"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/btn_admin_recipes"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#5D4037" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:text="Quản lý món ăn"
                            android:textColor="#3E2723"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_admin_3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFEBE9"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/btn_admin_stats"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_report_image"
                            app:tint="#5D4037" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:text="Thống kê hệ thống"
                            android:textColor="#3E2723"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_admin_4"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFEBE9"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/btn_admin_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#5D4037" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:text="Quản lý đánh giá"
                            android:textColor="#3E2723"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_admin_5"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EFEBE9"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/btn_admin_chat"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/stat_notify_chat"
                            app:tint="#5D4037" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:text="Chat với người dùng"
                            android:textColor="#3E2723"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nút Đăng xuất -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="40dp"
                android:fontFamily="serif"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:textColor="#B71C1C"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="28dp"
                app:strokeColor="#B71C1C"
                app:strokeWidth="1.5dp"
                app:elevation="2dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
