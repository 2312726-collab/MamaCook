<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="horizontal">

    <!-- Cột số bước + đường kẻ dọc -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tv_so_buoc"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_orange"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#FFE0B2"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Card nội dung bước -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FDF8F5"
        app:contentPadding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_step_card_outline">

            <!-- Header: Tiêu đề + Thời gian -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_tieu_de_buoc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sơ chế cá &amp; nguyên liệu"
                    android:textColor="@color/text_brown"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_thoi_gian_buoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 phút"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Layout chi tiết: Ảnh + Nội dung -->
            <LinearLayout
                android:id="@+id/layout_chi_tiet_buoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Ảnh minh họa -->
                <ImageView
                    android:id="@+id/img_buoc_nau"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginHorizontal="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_splash"
                    android:background="@drawable/bg_ingredient_item"
                    android:clipToOutline="true" />

                <!-- Nội dung chi tiết -->
                <TextView
                    android:id="@+id/tv_noi_dung_buoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Mô tả chi tiết bước nấu..."
                    android:textColor="@color/text_brown"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
