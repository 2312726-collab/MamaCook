<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/text_secondary"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_stt_nguyen_lieu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ic_nav_profile"
                android:backgroundTint="@color/brand_primary"
                android:textColor="@color/white"
                android:text="1"
                android:gravity="center"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edt_sub_ten_nguyen_lieu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Tên nguyên liệu..."
                android:textSize="14sp"
                android:background="@null"
                android:textColor="@color/text_brown"/>

            <ImageButton
                android:id="@+id/btn_delete_nguyen_lieu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/button_favorite_selected"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/edt_sub_so_luong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Số lượng (Số)"
                android:textSize="13sp"
                android:inputType="numberDecimal"/>

            <EditText
                android:id="@+id/edt_sub_don_vi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Đơn vị (g, cái...)"
                android:textSize="13sp"
                android:inputType="text"/>
        </LinearLayout>

        <EditText
            android:id="@+id/edt_sub_ghi_chu_nguyen_lieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Ghi chú chọn lựa (Không bắt buộc)..."
            android:textSize="13sp"
            android:inputType="text"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>