<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F1E7"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản lý tài khoản"
        android:textColor="#3E2723"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Theo dõi, khóa tài khoản và xử lý người dùng vi phạm"
        android:textColor="#8D6E63"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/edt_search_user"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="🔍  Tìm theo tên hoặc email"
        android:background="@drawable/bg_input_field"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#3E2723"
        android:textColorHint="#9E9E9E"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_filter_container"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_tat_ca_tai_khoan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Tất cả"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_button" />

        <Button
            android:id="@+id/btn_tai_khoan_vi_pham"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Vi phạm"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_button" />
    </LinearLayout>
    <Button
        android:id="@+id/btn_update_vi_pham"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cập nhật vi phạm"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E65100"
        android:layout_marginBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_users_admin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>