<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ForgotPasswordActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="130dp"
                android:layout_marginTop="30dp"
                android:src="@drawable/ic_mama" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:text="Mama Cook"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold|italic" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#CCF5F5DC"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="serif"
                        android:text="Quên Mật Khẩu"
                        android:textColor="#4E342E"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Chọn phương thức để khôi phục mật khẩu"
                        android:textColor="#555555"
                        android:textSize="14sp" />

                    <!-- CHỌN PHƯƠNG THỨC -->
                    <LinearLayout
                        android:id="@+id/layout_select_method"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_method_email"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_input_field"
                            android:drawableStart="@drawable/ic_nav_profile"
                            android:drawablePadding="10dp"
                            android:paddingHorizontal="20dp"
                            android:text="Khôi phục qua Email"
                            android:textAllCaps="false"
                            android:textColor="#4E342E"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_method_phone"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/bg_input_field"
                            android:drawableStart="@drawable/ic_nav_profile"
                            android:drawablePadding="10dp"
                            android:paddingHorizontal="20dp"
                            android:text="Khôi phục qua Số điện thoại"
                            android:textAllCaps="false"
                            android:textColor="#4E342E"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- NHẬP EMAIL/SĐT -->
                    <LinearLayout
                        android:id="@+id/layout_input_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/et_forgot_input"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_input_field"
                            android:drawableStart="@drawable/ic_nav_profile"
                            android:drawablePadding="10dp"
                            android:hint="Nhập Email hoặc SĐT"
                            android:paddingHorizontal="15dp"
                            android:textColor="@color/black" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_send_code"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/bg_register_button"
                            android:text="Gửi mã xác nhận"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- NHẬP OTP / MÃ XÁC NHẬN -->
                    <LinearLayout
                        android:id="@+id/layout_verify_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/et_otp_forgot"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="Nhập mã OTP"
                            android:inputType="number"
                            android:paddingHorizontal="15dp"
                            android:textColor="@color/black" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_verify_forgot"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/bg_register_button"
                            android:text="Xác thực mã"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- THIẾT LẬP MẬT KHẨU MỚI -->
                    <LinearLayout
                        android:id="@+id/layout_reset_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#4E342E">

                            <EditText
                                android:id="@+id/et_new_password"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:background="@drawable/bg_input_field"
                                android:drawableStart="@drawable/ic_lock_outline"
                                android:drawablePadding="10dp"
                                android:hint="Mật khẩu mới"
                                android:inputType="textPassword"
                                android:paddingHorizontal="15dp"
                                android:textColor="@color/black" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#4E342E">

                            <EditText
                                android:id="@+id/et_confirm_new_password"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:background="@drawable/bg_input_field"
                                android:drawableStart="@drawable/ic_lock_outline"
                                android:drawablePadding="10dp"
                                android:hint="Xác nhận mật khẩu mới"
                                android:inputType="textPassword"
                                android:paddingHorizontal="15dp"
                                android:textColor="@color/black" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_update_password"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/bg_register_button"
                            android:text="Cập nhật mật khẩu"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NÚT QUAY LẠI ĐĂNG NHẬP NỔI BẬT -->
            <LinearLayout
                android:id="@+id/btn_back_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#4E342E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Quay lại Đăng nhập"
                    android:textColor="#4E342E"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
