<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_corner_parchment"
    android:theme="@style/Theme.MaterialComponents.Light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"/>

        <!-- Số sao -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rating_label"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="8dp"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_4"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_4_plus"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_3"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_3_plus"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_2"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_2_plus"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_1"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_1_plus"/>
        </com.google.android.material.chip.ChipGroup>

        <!-- Thời gian -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cooking_time"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_time_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_time_15"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_under_15"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_time_30"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_15_30"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_time_60"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_30_60"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_time_above_60"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_above_60"/>
        </com.google.android.material.chip.ChipGroup>

        <!-- Độ khó -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/difficulty"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_difficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_diff_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_diff_easy"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diff_easy"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_diff_medium"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diff_medium"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_diff_hard"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diff_hard"/>
        </com.google.android.material.chip.ChipGroup>

        <!-- Danh mục (MỚI) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Danh mục"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all" />
            <!-- Các chip danh mục sẽ được thêm động từ code -->
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_filter"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="@string/apply_filter"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FF4D00"
            app:cornerRadius="12dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
