<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.EditAccountActivity">

    <!-- 1. Background gỗ toàn màn hình đồng bộ với app -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        android:contentDescription="@null" />

    <!-- 2. Header Section -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="50dp"
        android:paddingBottom="15dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_edit_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="serif"
            android:text="Chỉnh sửa hồ sơ"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <!-- 3. Tấm nền giấy da bo tròn (Parchment effect) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:text="Thông tin cá nhân"
                android:textColor="#4E342E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Form nhập liệu -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:cardBackgroundColor="#FDF5E6"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Họ và tên -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Họ và tên"
                        android:textColor="#8D6E63"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_edit_name"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="serif"
                        android:hint="Nhập họ và tên"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="15dp"
                        android:textColor="#4E342E"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#E0D4C3" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Email"
                        android:textColor="#8D6E63"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_edit_email"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="serif"
                        android:hint="Nhập email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="15dp"
                        android:textColor="#4E342E"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#E0D4C3" />

                    <!-- Số điện thoại -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Số điện thoại"
                        android:textColor="#8D6E63"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_edit_phone"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="serif"
                        android:hint="Nhập số điện thoại"
                        android:inputType="phone"
                        android:paddingHorizontal="15dp"
                        android:textColor="#4E342E"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#E0D4C3" />

                    <!-- Vai trò (Màu chữ nhạt hơn để báo hiệu không cho sửa) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Vai trò"
                        android:textColor="#8D6E63"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_edit_role"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="serif"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:text="Người dùng"
                        android:textColor="#A1887F"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#E0D4C3" />

                    <!-- Ngày tham gia -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Ngày tham gia"
                        android:textColor="#8D6E63"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_edit_date"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="serif"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:text="01/01/2024"
                        android:textColor="#A1887F"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nút Lưu -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:fontFamily="serif"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
                android:textColor="#B71C1C"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/white"
                app:cornerRadius="30dp"
                app:strokeColor="#B71C1C"
                app:strokeWidth="1.5dp"
                app:elevation="2dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
