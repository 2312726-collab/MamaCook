<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"> <!-- Màu nền kem giấy cũ -->

    <!-- Thanh tiêu đề phía trên (Header Background) -->
    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#6D4C41"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nội dung có thể cuộn -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="110dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:text="Thông tin cá nhân"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Thẻ chỉnh sửa thông tin -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:cardBackgroundColor="#FDF5E6"
                app:cardCornerRadius="15dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <!-- Họ và tên (Cho phép sửa) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Họ và tên"
                        android:textColor="#5D4037"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_edit_name"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="serif"
                        android:hint="Nhập họ tên"
                        android:paddingHorizontal="15dp"
                        android:textColor="#3E2723"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="15dp" android:background="#EFEBE9" />

                    <!-- Email (Chỉ xem) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Email (Không thể sửa)"
                        android:textColor="#5D4037"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_edit_email"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_field"
                        android:enabled="false"
                        android:fontFamily="serif"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:text="email@example.com"
                        android:textColor="#8D6E63"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="15dp" android:background="#EFEBE9" />

                    <!-- Số điện thoại (Cho phép sửa) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Số điện thoại"
                        android:textColor="#5D4037"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_edit_phone"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="serif"
                        android:hint="Nhập số điện thoại"
                        android:inputType="phone"
                        android:paddingHorizontal="15dp"
                        android:textColor="#3E2723"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="15dp" android:background="#EFEBE9" />

                    <!-- Vai trò (Chỉ xem) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Vai trò"
                        android:textColor="#5D4037"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_edit_role"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_field"
                        android:enabled="false"
                        android:fontFamily="serif"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:text="Người dùng"
                        android:textColor="#8D6E63"
                        android:textSize="16sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="15dp" android:background="#EFEBE9" />

                    <!-- Ngày tham gia (Chỉ xem) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Ngày tham gia"
                        android:textColor="#5D4037"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_edit_date"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_field"
                        android:enabled="false"
                        android:fontFamily="serif"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="15dp"
                        android:text="12/03/2025"
                        android:textColor="#8D6E63"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nút Lưu hình viên thuốc -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="40dp"
                android:fontFamily="serif"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#6D4C41"
                app:cornerRadius="30dp"
                app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Header Content -->
    <LinearLayout
        android:id="@+id/header_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="55dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_edit_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="serif"
            android:text="Chỉnh sửa thông tin"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
