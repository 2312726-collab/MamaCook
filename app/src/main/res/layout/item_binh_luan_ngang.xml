<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFF8F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTenNguoiBinhLuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên người dùng"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <RatingBar
            android:id="@+id/rbSaoBinhLuan"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:numStars="5"
            android:rating="5"
            android:progressTint="#FFB300"
            android:secondaryProgressTint="#FFB300" />

        <TextView
            android:id="@+id/tvNoiDungBinhLuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nội dung bình luận cực kỳ ngon và hấp dẫn..."
            android:textColor="#4E342E"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Comment Image (optional, only if exists) -->
        <ImageView
            android:id="@+id/imgBinhLuan"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/bg_ingredient_item" />

        <!-- Hidden Avatar for compatibility with Adapter if needed -->
        <ImageView
            android:id="@+id/imgAvatarBinhLuan"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
