<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_white_card"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bước 1"
            android:textStyle="bold"
            android:textColor="@color/text_brown"
            android:textSize="16sp"/>

        <ImageButton
            android:id="@+id/btnRemoveStep"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D32F2F"/>
    </RelativeLayout>

    <EditText
        android:id="@+id/edtStepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Tiêu đề bước (VD: Sơ chế thịt)"
        android:background="@drawable/bg_edittext"
        android:padding="10dp"
        android:textSize="14sp"
        android:textColor="@color/text_brown"/>

    <EditText
        android:id="@+id/edtStepDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Mô tả chi tiết cách thực hiện..."
        android:background="@drawable/bg_edittext"
        android:padding="10dp"
        android:textSize="14sp"
        android:gravity="top"
        android:minLines="3"
        android:textColor="@color/text_brown"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDDDDD">

            <ImageView
                android:id="@+id/imgStep"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_splash"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectStepImg"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Thêm ảnh"
            android:textColor="@color/orange_main"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <EditText
            android:id="@+id/edtStepTime"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:hint="Phút"
            android:inputType="number"
            android:background="@drawable/bg_edittext"
            android:padding="10dp"
            android:textSize="14sp"
            android:gravity="center"/>
    </LinearLayout>

</LinearLayout>
