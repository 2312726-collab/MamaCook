<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.PreviewAvatarActivity">

    <!-- 1. Background gỗ toàn màn hình đồng bộ với app -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        android:contentDescription="@null" />

    <!-- 2. Header Section -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="60dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_preview_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Xem ảnh đại diện"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Tấm nền giấy da chứa nội dung chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_home_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="serif"
            android:text="Ảnh đại diện mới của bạn"
            android:textColor="#3E2723"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Vùng hiển thị ảnh tròn với khung chuyên nghiệp -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_preview_avatar"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="40dp"
            android:padding="5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:shapeAppearanceOverlay="@style/Circle"
            app:strokeColor="#6D4C41"
            app:strokeWidth="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="serif"
            android:text="Ảnh sẽ được hiển thị như hình trên"
            android:textColor="#6D4C41"
            android:textSize="17sp"
            android:textStyle="italic" />

        <!-- Nút Căn chỉnh ảnh (Kiểu cũ, không icon bánh răng) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_adjust_avatar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="serif"
            android:text="Căn chỉnh ảnh"
            android:textAllCaps="false"
            android:textColor="#5D4037"
            android:textSize="20sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_crop"
            app:iconSize="26dp"
            app:iconTint="#5D4037" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hàng nút bấm Hủy và Lưu (Thiết kế to và rõ nét) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_preview"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="#5D4037"
                android:textSize="19sp"
                android:textStyle="bold"
                app:cornerRadius="35dp"
                app:strokeColor="#5D4037"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_avatar"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1.3"
                android:fontFamily="serif"
                android:text="Lưu ảnh"
                android:textAllCaps="false"
                android:textColor="#B71C1C"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@color/white"
                app:cornerRadius="35dp"
                app:strokeColor="#B71C1C"
                app:strokeWidth="2dp"
                app:elevation="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Giữ lại các ID cũ để không lỗi logic Java -->
    <View
        android:id="@+id/view_circle_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
