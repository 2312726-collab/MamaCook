<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FDFDFD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatarBinhLuan"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_mama"
                app:shapeAppearanceOverlay="@style/Circle" />

            <TextView
                android:id="@+id/tvTenNguoiBinhLuan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/imgAvatarBinhLuan"
                android:layout_marginStart="12dp"
                android:text="Khách hàng"
                android:textStyle="bold"
                android:textColor="@color/text_brown"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvNgayBinhLuan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/imgAvatarBinhLuan"
                android:layout_below="@id/tvTenNguoiBinhLuan"
                android:layout_marginStart="12dp"
                android:text="2 giờ trước"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <RatingBar
                android:id="@+id/rbSaoBinhLuan"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:numStars="5"
                android:progressTint="#FFC107"
                android:secondaryProgressTint="#FFC107"
                android:theme="@style/RatingBarTheme" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvNoiDungBinhLuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nội dung đánh giá hiển thị ở đây..."
            android:textColor="#3E2723"
            android:lineSpacingExtra="4dp"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/imgBinhLuanDinhKem"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>