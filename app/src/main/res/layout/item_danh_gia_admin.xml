<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_admin_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_ten_nguoi_dung_dg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên người dùng"
        android:textColor="#4E342E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_noi_dung_dg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Nội dung đánh giá"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_so_sao_dg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Số sao: 5"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_trang_thai_dg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Trạng thái: hien_thi"
        android:textColor="#2E7D32"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_an_hien_dg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_button"
            android:text="Ẩn"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_xoa_dg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_admin_button"
            android:text="Xóa"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>