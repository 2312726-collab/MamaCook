<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_admin_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_ten_nguoi_dung_dg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tên người dùng"
            android:textColor="#4E342E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ngay_dg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12/10/2023"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_mon_an_dg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Món: Phở bò"
        android:textColor="@color/brand_primary"
        android:textSize="13sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/tv_noi_dung_dg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Nội dung đánh giá"
        android:textColor="#555555"
        android:textSize="14sp" />

    <RatingBar
        android:id="@+id/rb_so_sao_dg"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:isIndicator="true"
        android:numStars="5"
        android:progressTint="@color/gold_rating"
        android:rating="5"
        android:secondaryProgressTint="@color/transparent" />

    <TextView
        android:id="@+id/tv_trang_thai_dg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Trạng thái: hien_thi"
        android:textColor="#2E7D32"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_an_hien_dg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_button"
            android:text="Ẩn"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_xoa_dg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_admin_button"
            android:text="Xóa"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>