<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F3EC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢 Gửi thông báo"
                android:textColor="#0F2747"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gửi thông báo đến tất cả người dùng"
                android:textColor="#7B7280"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_notification_card">

                <EditText
                    android:id="@+id/edt_tieu_de_thong_bao"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_admin_input"
                    android:hint="Nhập tiêu đề"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <EditText
                    android:id="@+id/edt_noi_dung_thong_bao"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_admin_input"
                    android:gravity="top"
                    android:hint="Nhập nội dung thông báo"
                    android:padding="14dp" />

                <Button
                    android:id="@+id/btn_gui_thong_bao"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_admin_button"
                    android:text="Gửi thông báo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông báo đã gửi"
                android:textColor="#0F2747"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_thong_bao_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_thong_bao" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>